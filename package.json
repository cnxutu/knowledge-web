{
  "name": "knowledge-web",
  "private": true,
  "packageManager": "pnpm@11.0.7",
  "scripts": {
    "dev": "node ./node_modules/turbo/bin/turbo run dev --parallel",
    "dev:admin": "node ./node_modules/pnpm/bin/pnpm.cjs --filter @knowledge/admin dev",
    "dev:web": "node ./node_modules/pnpm/bin/pnpm.cjs --filter @knowledge/web dev",
    "build": "node ./node_modules/turbo/bin/turbo run build",
    "build:admin": "node ./node_modules/pnpm/bin/pnpm.cjs --filter @knowledge/admin build",
    "build:web": "node ./node_modules/pnpm/bin/pnpm.cjs --filter @knowledge/web build",
    "lint": "node ./node_modules/turbo/bin/turbo run lint",
    "typecheck": "node ./node_modules/turbo/bin/turbo run typecheck",
    "test": "node ./node_modules/turbo/bin/turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@mdx-js/mdx": "^3.1.1",
    "@next/mdx": "^15.3.5",
    "@tanstack/react-query": "^5.83.0",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "axios": "^1.12.2",
    "element-plus": "^2.11.4",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-vue": "^10.4.0",
    "gray-matter": "^4.0.3",
    "globals": "^16.3.0",
    "next": "^15.5.6",
    "next-mdx-remote": "^5.0.0",
    "pinia": "^3.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
